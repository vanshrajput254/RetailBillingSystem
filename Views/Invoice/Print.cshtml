@model RetailBillingSystem.Models.Invoice
@{
    ViewData["Title"] = "Print Invoice";
    Layout = null; // No layout for print page
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.InvoiceNumber</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; font-size: 12px; color: #222; padding: 20px; }
        .invoice { max-width: 800px; margin: auto; border: 1px solid #ddd; padding: 24px; }
        .header { display: flex; justify-content: space-between; margin-bottom: 20px; }
        .company-name { font-size: 20px; font-weight: bold; color: #185FA5; }
        .inv-number { font-size: 16px; font-weight: bold; text-align: right; }
        .section { margin-bottom: 16px; }
        .label { font-size: 10px; text-transform: uppercase; color: #888; margin-bottom: 2px; }
        table { width: 100%; border-collapse: collapse; margin: 12px 0; }
        th { background: #f0f4f8; padding: 7px; text-align: left; font-size: 11px; border: 1px solid #ddd; }
        td { padding: 6px 7px; border: 1px solid #eee; }
        .totals { display: flex; justify-content: flex-end; }
        .totals-inner { min-width: 220px; }
        .tot-row { display: flex; justify-content: space-between; padding: 3px 0; }
        .tot-row.grand { font-weight: bold; font-size: 14px; border-top: 2px solid #333; padding-top: 6px; margin-top: 4px; }
        .badge { display: inline-block; padding: 2px 10px; border-radius: 99px; font-size: 11px; font-weight: bold; }
        .badge-paid    { background: #d4edda; color: #155724; }
        .badge-pending { background: #fff3cd; color: #856404; }
        .badge-overdue { background: #f8d7da; color: #721c24; }
        .footer { margin-top: 24px; font-size: 10px; color: #999; text-align: center; border-top: 1px solid #eee; padding-top: 10px; }
        @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
<div class="no-print" style="margin-bottom:12px;">
    <button onclick="window.print()" style="padding:8px 16px;cursor:pointer;background:#185FA5;color:#fff;border:none;border-radius:4px;">🖨 Print</button>
    <button onclick="window.close()" style="padding:8px 16px;cursor:pointer;margin-left:8px;">Close</button>
</div>

<div class="invoice">
    <div class="header">
        <div>
            <div class="company-name">RetailBill Pro</div>
            <div>123, MG Road, Bengaluru - 560001</div>
            <div>GSTIN: 29ASHSS1234R1Z1</div>
            <div>Ph: +91-9876543210</div>
        </div>
        <div style="text-align:right;">
            <div class="inv-number">TAX INVOICE</div>
            <div style="font-size:14px;">@Model.InvoiceNumber</div>
            <div>Date: @Model.InvoiceDate.ToString("dd MMM yyyy")</div>
            @if (Model.DueDate.HasValue)
            { <div>Due: @Model.DueDate.Value.ToString("dd MMM yyyy")</div> }
            <div style="margin-top:6px;">
                <span class="badge badge-@Model.Status.ToString().ToLower()">@Model.Status</span>
            </div>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
        <div>
            <div class="label">Bill To</div>
            <div style="font-weight:bold;">@Model.Customer?.Name</div>
            <div>@Model.Customer?.Address</div>
            <div>@Model.Customer?.City, @Model.Customer?.State @Model.Customer?.PinCode</div>
            @if (!string.IsNullOrEmpty(Model.Customer?.GSTIN))
            { <div>GSTIN: @Model.Customer.GSTIN</div> }
        </div>
        <div>
            <div class="label">Buyer GSTIN</div>
            <div>@(Model.BuyerGSTIN ?? "—")</div>
            <div class="label" style="margin-top:8px;">GST Type</div>
            <div>@(Model.GSTType == RetailBillingSystem.Models.GSTType.IGST ? "IGST (Inter-state)" : "CGST + SGST (Intra-state)")</div>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th><th>Description</th><th>Qty</th><th>Rate (₹)</th>
                <th>Disc %</th><th>Taxable (₹)</th><th>GST %</th><th>GST Amt (₹)</th><th>Total (₹)</th>
            </tr>
        </thead>
        <tbody>
            @{ int sno = 1; }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@(sno++)</td>
                    <td>@item.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@item.Rate.ToString("N2")</td>
                    <td>@item.DiscountPercent%</td>
                    <td>@item.TaxableAmount.ToString("N2")</td>
                    <td>@item.GSTRate%</td>
                    <td>@item.GSTAmount.ToString("N2")</td>
                    <td>@item.LineTotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="totals">
        <div class="totals-inner">
            <div class="tot-row"><span>Subtotal</span><span>₹@Model.Subtotal.ToString("N2")</span></div>
            <div class="tot-row"><span>Discount</span><span>−₹@Model.TotalDiscount.ToString("N2")</span></div>
            <div class="tot-row"><span>Taxable Amount</span><span>₹@Model.TaxableAmount.ToString("N2")</span></div>
            @if (Model.GSTType == RetailBillingSystem.Models.GSTType.CGST_SGST)
            {
                <div class="tot-row"><span>CGST</span><span>₹@Model.CGSTAmount.ToString("N2")</span></div>
                <div class="tot-row"><span>SGST</span><span>₹@Model.SGSTAmount.ToString("N2")</span></div>
            }
            else
            {
                <div class="tot-row"><span>IGST</span><span>₹@Model.IGSTAmount.ToString("N2")</span></div>
            }
            <div class="tot-row grand"><span>Grand Total</span><span>₹@Model.GrandTotal.ToString("N2")</span></div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notes))
    { <div style="margin-top:14px;font-size:11px;color:#555;">Notes: @Model.Notes</div> }

    <div class="footer">
        This is a computer-generated invoice. No signature required. | RetailBill Pro — ASP.NET MVC 8
    </div>
</div>
</body>
</html>
